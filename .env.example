# Environment Mode (development, test, production)
NODE_ENV=development
PORT=3000

# Shared PostgreSQL Container Configuration
POSTGRES_HOST=shared_postgres
POSTGRES_PORT=5432
POSTGRES_USER=jedana_user
POSTGRES_PASSWORD=
POSTGRES_DB=jedana_db

# Optional Direct Database URL override
# DATABASE_URL=postgres://user:password@host:5432/database

# Security & Application Secret (ADR-0007: minimal 32 karakter, tanpa fallback di kode)
# Bangkitkan nilai acak:
# openssl rand -base64 48   # tempel ke .env sebagai JWT_SECRET (≥ 32 karakter)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend Domain & CORS Settings (wajib URL ber-skema https:// pada NODE_ENV=production)
FRONTEND_URL=

# Google OAuth Credentials (wajib pada NODE_ENV=production, didapat dari Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# MCP (Model Context Protocol)
# MCP endpoint is available at /mcp
# Authentication: API key generated from Settings page
# Rate limit: same as REST API (100 req/60s)
